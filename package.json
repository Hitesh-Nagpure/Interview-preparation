{
  "name": "ssb-psych-prep",
  "version": "1.0.0",
  "description": "SSB Psychological Test Preparation Web App for TAT & WAT",
  "main": "server/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev:server": "node server/server.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix client",
    "prod": "npm run build --prefix client && node server/server.js"
  },
  "dependencies": {
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
